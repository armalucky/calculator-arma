{
  "name": "luckymap-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "prepare:resources": "node scripts/prepare-resources.mjs",
    "predev": "npm run prepare:resources",
    "prebuild": "npm run prepare:resources",
    "test": "npm run prepare:resources && node --experimental-strip-types --test tests/*.test.mjs",
    "verify:delivery": "node --experimental-strip-types scripts/verify-resource-delivery.mjs",
    "reference:domain": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Export-DomainReference.ps1",
    "verify:storage-desktop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Verify-StorageInterop.ps1",
    "verify:storage-browser": "node scripts/verify-storage-browser.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "package:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Package-Web.ps1",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "check": "npm run typecheck && npm run lint",
    "format": "oxfmt"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "type": "module"
}
